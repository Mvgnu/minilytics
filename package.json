{
  "name": "minilytics",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @minilytics/dashboard run dev",
    "build": "npm --workspace @mvgnu/minilytics run build && npm --workspace @minilytics/dashboard run build",
    "db:migrate": "node scripts/setup.mjs migrate",
    "site:create": "node scripts/setup.mjs site:create"
  },
  "engines": {
    "node": ">=20.9"
  }
}
