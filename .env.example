DATABASE_URL=postgres://minilytics:minilytics@localhost:5432/minilytics
DASHBOARD_PASSWORD=change-me

# Canonical public origin of the deployed dashboard. Required for OAuth resource binding.
MINILYTICS_PUBLIC_URL=http://localhost:3000

# Use a separate random production secret (32+ bytes recommended).
# Falls back to DASHBOARD_PASSWORD only for simple local setups.
MINILYTICS_OAUTH_SECRET=replace-with-a-long-random-secret
